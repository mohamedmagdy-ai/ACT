{
  "name": "sz-electron",
  "version": "1.3.5",
  "description": "نظام ACT للمبيعات والصيانة",
  "main": "main.js",
  "author": "",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish always",
    "test": "node tests/run-all.js"
  },
  "dependencies": {
    "sql.js": "^1.14.2",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "com.act.salesmaintenance",
    "productName": "ACT - نظام المبيعات والصيانة",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "db/**/*",
      "lib/**/*",
      "build/icon.ico"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "mohamedmagdy-ai",
      "repo": "ACT",
      "releaseType": "release"
    }
  }
}